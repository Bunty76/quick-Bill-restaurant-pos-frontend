# ============================================================
# QuickBill Restaurant POS — Frontend Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# IMPORTANT: Never commit .env to git — only .env.example is committed.
#
# Vite only exposes variables prefixed with VITE_ to the browser.
# ============================================================

# ── Backend API URL ──────────────────────────────────────────
# The base URL of your hosted backend (without /api at the end).
# Used by vite.config.ts to proxy /api requests during local dev.
# For local backend: http://localhost:5000
# For Render hosted: https://quick-bill-restaurant-pos.onrender.com
VITE_BACKEND_URL=https://quick-bill-restaurant-pos.onrender.com
